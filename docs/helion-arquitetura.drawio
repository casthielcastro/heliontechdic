eometry x="400" y="420" width="28" height="28" as="geometry"/></mxCell><mxCell id="b4" value="4" style="ellipse;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="28" height="28" as="geometry"/></mxCell><mxCell id="b5" value="5" style="ellipse;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="500" width="28" height="28" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Fluxo&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. O usuário acessa o site via HTTPS.&lt;br&gt;2. /assets/* é servido do S3 privado via OAC.&lt;br&gt;3. As demais rotas vão para a Function URL do Lambda (SSR).&lt;br&gt;4. O Lambda chama a API Gemini (gemini-flash-latest).&lt;br&gt;5. O Lambda lê/grava dados no Supabase.&lt;br&gt;&lt;br&gt;AWS Budgets envia alerta ao atingir US$ 5." style="rounded=1;arcSize=3;fillColor=light-dark(#EDF3FF,#305363);fillStyle=auto;strokeColor=none;align=left;verticalAlign=top;spacing=16;fontSize=13;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="130" width="330" height="550" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>